[Unit]
Description=EMO Core API, PostgreSQL and worker
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/emo-core/source/emo_core
ExecStart=/usr/bin/docker compose -f docker-compose.yml -f /opt/emo-core/ops/compose.server.yml up -d --no-build --wait --wait-timeout 180
ExecStop=/usr/bin/docker compose -f docker-compose.yml -f /opt/emo-core/ops/compose.server.yml stop
TimeoutStartSec=240
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
