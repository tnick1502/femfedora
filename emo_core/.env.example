EMO_HTTP_PORT=8086
APP_ENV=development
LOG_LEVEL=INFO
# Заполнит emo-config init-env; при ручном вводе пароль должен быть URL-encoded.
DATABASE_URL=
POSTGRES_USER=emo
POSTGRES_DB=emo
POSTGRES_PASSWORD=
JWT_ISSUER=https://identity.example.invalid/
JWT_AUDIENCE=emo-core
JWT_JWKS_URL=
AI_MODE=mock
DEMO_AUTH_ENABLED=true
# Уникальные локальные секреты создаёт emo-config init-env.
DEMO_JWT_SECRET=
# Вход в консоль (демо и администрирование). Пароль от 12 символов; значение со спецсимволами — в одинарных кавычках.
APP_LOGIN=
APP_PASSWORD=
CONSOLE_SESSION_HOURS=8
API_KEY_TTL_DAYS=30
ADMIN_API_TOKEN=
MODEL_SECRETS_KEY=
# Дополнительные ключи: JSON map, значения доступны только на сервере.
MODEL_CREDENTIALS='{}'
LLM_BASE_URL=https://api.example.invalid/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# Дополнительные поля запроса провайдера (JSON). DeepSeek без рассуждений: '{"thinking":{"type":"disabled"}}'
LLM_EXTRA_BODY='{}'
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.14.0
JEV_TIMEOUT_SECONDS=15
JEV_THRESHOLD=0.7
JEV_REVIEW_THRESHOLD=0.35
# Отдельные пороги: чувствительные маркеры (самоповреждение, срочная медицина) и проверка готового ответа.
JEV_SENSITIVE_REVIEW_THRESHOLD=0.12
JEV_OUTPUT_THRESHOLD=0.5
JEV_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=600
# Окно модели и резерв: из них считается бюджет контекста беседы.
CONTEXT_WINDOW_TOKENS=256000
CONTEXT_SAFETY_MARGIN_TOKENS=16000
# Обезличивание перед отправкой внешним моделям: user — решает пользователь, always, never.
ANONYMIZE_OUTBOUND=user
EXTERNAL_AI_ALLOWED=false
ALLOWED_LLM_HOSTS=api.example.invalid
ALLOWED_JEV_HOSTS=api.typesafe.ai
AI_PROCESSING_REGION=
PROACTIVE_WORKER_ENABLED=true
PROACTIVE_POLL_SECONDS=300
RETENTION_DAYS=365
# Предел соединений с БД на процесс: DB_POOL_SIZE + DB_MAX_OVERFLOW.
# Во время вызова моделей чат соединение не удерживает.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Пусто — использовать встроенные YAML-политики.
POLICY_DIR=
