        ],
        "in_total": true
      },
      {
        "id": "18",
        "text": "Саморазрушительное или безрассудное поведение",
        "options": [
          "Не испытывала",
          "1 раз",
          "2-4 раза",
          "5 или более раз"
        ],
        "score_map": [
          0,
