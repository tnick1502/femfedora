        ],
        "in_total": true
      },
      {
        "id": "19",
        "text": "Чувство напряженности или взвинченности",
        "options": [
          "Не испытывала",
          "1 раз",
          "2-4 раза",
          "5 или более раз"
        ],
        "score_map": [
          0,
