.DS_Store
Thumbs.db

# Jupyter
**/.ipynb_checkpoints/

# Python
.venv/
**/__pycache__/
*.py[cod]

# Локальное состояние Obsidian
knowledge-base/.obsidian/workspace*.json
knowledge-base/.trash/

# Временные файлы
*.tmp
*.temp
~$*

# Тяжёлые артефакты обученных моделей
models/checkpoints/*
!models/checkpoints/.gitkeep
models/exported/*
!models/exported/.gitkeep

# Скачанные и производные данные не хранятся в обычном Git
data/raw/**/*
!data/raw/.gitkeep
data/external/**/*
!data/external/.gitkeep
!data/external/**/
!data/external/**/DATASET.md
data/interim/**/*
!data/interim/.gitkeep
data/processed/**/*
!data/processed/.gitkeep
!data/processed/**/
!data/processed/**/DATASET.md

# Реестр, схемы и небольшие воспроизводимые примеры остаются в Git
!data/registry/**
!data/samples/**

# Локальные промежуточные файлы
tmp/

# Individual research health records remain local; keep aggregate metrics.
research/experiments/ring_health/**/*_test_predictions.csv
research/experiments/ring_health/**/*_oof.csv
research/experiments/ring_health/**/*_split.csv
research/experiments/ring_health/**/*_folds.csv
research/experiments/ring_health/**/bayesian_forecast_predictions.csv
output/ring_health_mvp_v1.zip
output/ring_health_mvp_v2.zip
research/experiments/ring_health/**/*predictions.csv
